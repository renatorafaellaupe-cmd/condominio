{
  "rules": {
    ".read": false,
    ".write": false,
    "manutencao_condominios": {
      ".read": true,
      ".write": true,
      "$no": {
        ".validate": "$no === 'ativos' || $no === 'pmp' || $no === 'tarefas' || $no === 'fornecedores' || $no === 'solicitacoes' || $no === 'config'"
      },
      "config": {
        "seqSol": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())" },
        "seqOS":  { ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())" }
      }
    }
  }
}

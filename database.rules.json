{
  // =====================================================================
  //  GESTÃO DE MANUTENÇÃO PREDIAL · CONDOMÍNIOS
  //  Regras de Segurança (Realtime Database) — versão SEC-V1
  //  Projeto Firebase: gestaodecondominio-f7163
  //  Banco: https://gestaodecondominio-f7163-default-rtdb.firebaseio.com
  //  Casa com o index.html SEC-V1 (login + perfis + CSP + XSS).
  //  Publicar SOMENTE depois do index.html SEC-V1 estar no ar e do primeiro
  //  super_admin estar cadastrado em /usuarios (ver LEIA-ME.txt).
  //
  //  operador     nível 1 — equipe de manutenção. Lê tudo, cria e altera
  //                         tarefas (Kanban) e solicitações. Não cadastra
  //                         ativos, PMP ou fornecedores e não exclui nada.
  //  admin        nível 2 — gestão. Tudo do operador + cadastros, PMP,
  //                         configurações, solicitações e exclusões.
  //  super_admin  nível 3 — tudo do admin + criar, editar e desativar
  //                         usuários.
  //  morador      sem login — só CRIA solicitação nova (status "aberta"),
  //                         lê a lista de condomínios e consulta o próprio
  //                         protocolo (precisa do protocolo + unidade).
  //                         Não lê nenhum dado do sistema.
  // =====================================================================

  "rules": {

    // Nada é público. Todo caminho não previsto abaixo fica bloqueado.
    ".read": false,
    ".write": false,

    // -----------------------------------------------------------------
    // /usuarios — perfis de acesso (mesmo modelo da SEC-V5)
    // -----------------------------------------------------------------
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && root.child('usuarios').child(auth.uid).child('perfil').val() === 'super_admin'",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && root.child('usuarios').child(auth.uid).child('perfil').val() === 'super_admin'",

      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        // Registro completo + o super_admin não se rebaixa nem se desativa
        ".validate": "newData.hasChildren(['perfil', 'ativo']) && ($uid !== auth.uid || (newData.child('perfil').val() === 'super_admin' && newData.child('ativo').val() === true))",

        "nome":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "email":    { ".validate": "newData.isString() && newData.val().length <= 160" },
        "perfil":   { ".validate": "newData.isString() && (newData.val() === 'operador' || newData.val() === 'admin' || newData.val() === 'super_admin')" },
        "ativo":    { ".validate": "newData.isBoolean()" },
        "criadoEm": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "$outro":   { ".validate": false }
      }
    },

    // -----------------------------------------------------------------
    // /manutencao_condominios — base do sistema (um nó por item)
    //   Leitura: qualquer usuário ativo.
    //   Escrita: definida por coleção (não existe .write aqui em cima).
    // -----------------------------------------------------------------
    "manutencao_condominios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true",

      // Árvore de ativos — só admin/super_admin
      "ativos": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('perfil').val() === 'admin' || root.child('usuarios').child(auth.uid).child('perfil').val() === 'super_admin')",
        "$id": {
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,100}$/) && newData.child('id').val() === $id && newData.child('nome').isString() && newData.child('nome').val().length > 0 && newData.child('nome').val().length <= 200",
          "fotos":  { "$i": { ".validate": "newData.isString() && newData.val().length <= 700000 && newData.val().beginsWith('data:image/') && newData.val().contains(';base64,') && !newData.val().contains('\"') && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' ')" } },
          "$outro": { ".validate": "!newData.isString() || newData.val().length <= 20000" }
        }
      },

      // PMP — só admin/super_admin
      "pmp": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('perfil').val() === 'admin' || root.child('usuarios').child(auth.uid).child('perfil').val() === 'super_admin')",
        "$id": {
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,100}$/) && newData.child('id').val() === $id",
          "$outro": { ".validate": "!newData.isString() || newData.val().length <= 20000" }
        }
      },

      // Fornecedores — só admin/super_admin
      "fornecedores": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('perfil').val() === 'admin' || root.child('usuarios').child(auth.uid).child('perfil').val() === 'super_admin')",
        "$id": {
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,100}$/) && newData.child('id').val() === $id",
          "$outro": { ".validate": "!newData.isString() || newData.val().length <= 20000" }
        }
      },

      // Tarefas / OS — admin: tudo. Operador: cria e altera, nunca apaga.
      "tarefas": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('perfil').val() === 'admin' || root.child('usuarios').child(auth.uid).child('perfil').val() === 'super_admin')",
        "$id": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && newData.exists()",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,100}$/) && newData.child('id').val() === $id",
          "$outro": { ".validate": "!newData.isString() || newData.val().length <= 20000" }
        }
      },

      // Solicitações — admin: tudo. Operador: cria e altera, nunca apaga.
      //   Morador (sem login): só CRIA uma solicitação nova, sempre "aberta",
      //   sem OS, sem resposta e com no máximo 3 fotos. Não lê nem altera.
      "solicitacoes": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('perfil').val() === 'admin' || root.child('usuarios').child(auth.uid).child('perfil').val() === 'super_admin')",
        "$id": {
          ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && newData.exists()) || (!data.exists() && newData.exists())",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,100}$/) && newData.child('id').val() === $id && ((auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true) || (newData.hasChildren(['protocolo','condominioId','unidade','nome','assunto','descricao','criadoEm','status']) && newData.child('status').val() === 'aberta' && !newData.hasChild('osId') && !newData.hasChild('resposta') && !newData.hasChild('motivo') && !newData.hasChild('resolvidoEm') && !newData.hasChild('ativoId') && !newData.child('fotos').hasChild('3')))",

          "protocolo":    { ".validate": "newData.isString() && newData.val().matches(/^SOL-[0-9]{4}-[0-9]{1,8}$/)" },
          "condominioId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{0,100}$/)" },
          "unidade":      { ".validate": "newData.isString() && newData.val().length <= 60" },
          "nome":         { ".validate": "newData.isString() && newData.val().length <= 120" },
          "telefone":     { ".validate": "newData.isString() && newData.val().length <= 40" },
          "email":        { ".validate": "newData.isString() && newData.val().length <= 160" },
          "assunto":      { ".validate": "newData.isString() && newData.val().length <= 120" },
          "urgencia":     { ".validate": "newData.isString() && newData.val().matches(/^(Baixa|Normal|Alta|Urgente)$/)" },
          "local":        { ".validate": "newData.isString() && newData.val().length <= 300" },
          "descricao":    { ".validate": "newData.isString() && newData.val().length <= 4000" },
          "criadoEm":     { ".validate": "newData.isString() && newData.val().matches(/^([0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?)?$/)" },
          "resolvidoEm":  { ".validate": "newData.isString() && newData.val().matches(/^([0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?)?$/)" },
          "status":       { ".validate": "newData.isString() && newData.val().matches(/^(aberta|analise|atendimento|resolvida|recusada)$/)" },
          "_ord":         { ".validate": "newData.isNumber()" },
          "fotos":        { "$i": { ".validate": "newData.isString() && newData.val().length <= 700000 && newData.val().beginsWith('data:image/') && newData.val().contains(';base64,') && !newData.val().contains('\"') && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' ')" } },
          "historico":    {
            "$i": {
              "em":  { ".validate": "newData.isString() && newData.val().matches(/^([0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?)?$/)" },
              "txt": { ".validate": "newData.isString() && newData.val().length <= 500" }
            }
          },
          "$outro":       { ".validate": "!newData.isString() || newData.val().length <= 20000" }
        }
      },

      // Configurações — admin/super_admin.
      //   seqSol (protocolo do morador): qualquer um lê e soma exatamente +1
      //   (transação). Usuário ativo pode avançar, nunca voltar o contador.
      //   seqOS: usuário ativo pode avançar, nunca voltar.
      "config": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && (root.child('usuarios').child(auth.uid).child('perfil').val() === 'admin' || root.child('usuarios').child(auth.uid).child('perfil').val() === 'super_admin')",
        "seqSol": {
          ".read": true,
          ".write": "newData.exists()",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1) || ((auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true) && (!data.exists() || newData.val() >= data.val())))"
        },
        "seqOS": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true && newData.exists()",
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())"
        },
        "$outro": { ".validate": "!newData.isString() || newData.val().length <= 200" }
      },

      "$outro": { ".validate": false }
    },

    // -----------------------------------------------------------------
    // /manutencao_publico — o mínimo para o formulário do morador
    //   Gerado automaticamente pelo sistema (usuários logados).
    // -----------------------------------------------------------------
    "manutencao_publico": {

      // Nomes dos condomínios para a lista do formulário
      "condominios": {
        ".read": true,
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true",
        "$id": {
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,100}$/) && newData.hasChildren(['id', 'nome'])",
          "id":     { ".validate": "newData.val() === $id" },
          "nome":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "$outro": { ".validate": false }
        }
      },

      // Consulta de protocolo. A chave é um resumo de protocolo + unidade:
      // não dá para listar; só lê quem souber os dois.
      // Sem nome, telefone ou e-mail do morador.
      "consulta": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('ativo').val() === true",
        "$k": {
          ".read": true,
          // morador: só cria a entrada da própria solicitação, "aberta" e sem resposta
          ".write": "!data.exists() && newData.exists() && newData.child('status').val() === 'aberta' && !newData.hasChild('resposta')",
          ".validate": "$k.matches(/^c[a-z0-9]{2,30}$/) && newData.hasChildren(['protocolo', 'status'])",
          "protocolo": { ".validate": "newData.isString() && newData.val().matches(/^SOL-[0-9]{4}-[0-9]{1,8}$/)" },
          "status":    { ".validate": "newData.isString() && newData.val().matches(/^(aberta|analise|atendimento|resolvida|recusada)$/)" },
          "resposta":  { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "criadoEm":  { ".validate": "newData.isString() && newData.val().matches(/^([0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?)?$/)" },
          "$outro":    { ".validate": false }
        }
      },

      "$outro": { ".validate": false }
    }
  }
}
